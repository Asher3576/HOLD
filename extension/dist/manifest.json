{
  "manifest_version": 3,
  "name": "HOLD — 인사이트 프렌즈",
  "version": "0.5.3",
  "description": "보고 있는 차트 위에 계획을 — 실시세·지지/저항·손익비·작도. 지시 없음, 실거래 없음.",
  "action": {
    "default_title": "HOLD 열기"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["sidePanel", "activeTab", "scripting", "storage", "tabs"],
  "host_permissions": ["http://*/*", "https://*/*"]
}
